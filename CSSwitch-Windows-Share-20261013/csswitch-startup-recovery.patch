     }
 
+    /// Ownership, not health, authorizes recovery of an unresponsive old daemon.
+    /// This does not publish a healthy state or permit an authenticated request.
+    pub(crate) fn recover_owned_runtime(
+        port: u16,
+        version_cache: &ScienceVersionCache,
+    ) -> Result<Option<ScienceRuntimeIdentity>, String> {
+        for mut runtime in runtime_probe_candidates(port, version_cache)? {
+            if let Some(token) = Self::managed_receipt(port, &runtime) {
+                hydrate_runtime_adoption_from_managed_launch(&token, &mut runtime)?;
+                if Self::receipt_is_current(&token, &runtime) {
+                    return Ok(Some(runtime));
+                }
+            }
+        }
+        Ok(None)
+    }
+
     pub(crate) fn url(port: u16, runtime: &ScienceRuntimeIdentity) -> String {
         sandbox_url(port, runtime)
     }
