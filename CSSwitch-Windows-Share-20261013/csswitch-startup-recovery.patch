@@ -0,0 +1,80 @@
+// Appended to a generated crate-root fixture. All lifecycle modules are the
+// production files; no cfg(test) identity shortcuts or real Science are used.
+fn main() {
+    use std::{fs, io::{Read, Write}, net::{TcpListener, TcpStream}, process::{Command, Stdio}, time::{Duration, Instant}};
+    use crate::platform::CanonicalizeExt;
+    use runtime::science::{ScienceHostAdapter, ScienceVersionCache, SandboxScienceState};
+    let args: Vec<String> = std::env::args().collect();
+    if args.get(1).map(String::as_str) == Some("--version") {
+        println!("claude-science 0.1.60 synthetic"); return;
+    }
+    if args.get(1).map(String::as_str) == Some("stop") { return; } // deliberately dishonest CLI
+    if args.get(1).map(String::as_str) == Some("status") { std::process::exit(1); }
+    if args.get(1).map(String::as_str) == Some("--synthetic-server") {
+        let listener=TcpListener::bind(("127.0.0.1",args[2].parse::<u16>().unwrap())).unwrap();
+        for stream in listener.incoming() {
+            let mut stream=stream.unwrap();
+            stream.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
+            let mut request=[0;1024]; let _=stream.read(&mut request);
+            let _=stream.write_all(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+        }
+        return;
+    }
+    let home=std::path::PathBuf::from(std::env::var_os("CSSWITCH_FIXTURE_HOME").expect("isolated HOME required"));
+    assert!(!home.exists(),"fixture must use fresh data");
+    fs::create_dir_all(&home).unwrap();
+    std::env::set_var("HOME",&home);
+    std::env::set_var("USERPROFILE",&home);
+    std::env::set_var("APPDATA",home.join("AppData/Roaming"));
+    std::env::set_var("LOCALAPPDATA",home.join("AppData/Local"));
+    let binary=std::env::current_exe().unwrap().canonicalize_norm().unwrap();
+    std::env::set_var("SCIENCE_BIN",&binary);
+    let socket=TcpListener::bind(("127.0.0.1",0)).unwrap();
+    let port=socket.local_addr().unwrap().port(); drop(socket);
+    assert_ne!(port,8765);
+    let dir=config::default_dir();
+    fs::create_dir_all(dir.join("sandbox/home/.claude-science")).unwrap();
+    let mut cfg=config::Config::default(); cfg.sandbox_port=port;
+    config::save_to(&dir,&cfg).unwrap();
+    let cache=ScienceVersionCache::default();
+    let runtime=runtime::science::select_science_runtime_cached(None,&cache).unwrap();
+    struct OwnedChild(std::process::Child);
+    impl Drop for OwnedChild {fn drop(&mut self){let _=self.0.kill();let _=self.0.wait();}}
+    let mut child=OwnedChild(Command::new(&binary).args(["--synthetic-server",&port.to_string()]).stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::null()).spawn().unwrap());
+    let deadline=Instant::now()+Duration::from_secs(5);
+    while TcpStream::connect(("127.0.0.1",port)).is_err(){assert!(Instant::now()<deadline);std::thread::sleep(Duration::from_millis(30));}
+    assert!(ScienceHostAdapter::recover_owned_runtime(port,&cache).unwrap().is_none());
+    assert!(ScienceHostAdapter::claim_stop(Some(&runtime)).is_err());
+    assert!(child.0.try_wait().unwrap().is_none());
+    println!("PASS: same binary on occupied port without receipt is preserved");
+    let receipt=runtime::science::record_managed_science_launch(port,&runtime).unwrap();
+    assert_eq!(ScienceHostAdapter::probe_known(port,&runtime),SandboxScienceState::Unknown);
+    let recovered=ScienceHostAdapter::recover_owned_runtime(port,&cache).unwrap().expect("unhealthy owned daemon must be recoverable");
+    assert!(ScienceHostAdapter::receipt_is_current(&receipt,&recovered));
+    println!("PASS: unhealthy persisted owner recovers without health/status success");
+    let receipt_path=dir.join("science-managed-launch.v1.json");
+    let original=fs::read(&receipt_path).unwrap();
+    for field in ["process_start","runtime_sha256","data_dir"] {
+        let mut changed:serde_json::Value=serde_json::from_slice(&original).unwrap();
+        changed[field]=serde_json::json!("wrong-owner");
+        fs::write(&receipt_path,serde_json::to_vec(&changed).unwrap()).unwrap();
+        assert!(ScienceHostAdapter::recover_owned_runtime(port,&cache).unwrap().is_none());
+        assert!(ScienceHostAdapter::claim_stop(Some(&runtime)).is_err());
+        assert!(child.0.try_wait().unwrap().is_none());
+        fs::write(&receipt_path,&original).unwrap();
+    }
+    println!("PASS: changed process creation time, executable digest and data directory refuse recovery");
+    let app=tauri::test::mock_builder().build(tauri::test::mock_context(tauri::test::noop_assets())).unwrap();
+    let request=ScienceHostAdapter::claim_stop(Some(&recovered)).unwrap();
+    let (outcome,_)=ScienceHostAdapter::execute_stop(app.handle(),request).into_parts();
+    assert!(outcome.is_ok(),"{outcome:?}");
+    assert!(child.0.try_wait().unwrap().is_some());
+    assert!(TcpStream::connect(("127.0.0.1",port)).is_err());
+    assert!(!receipt_path.exists());
+    println!("PASS: CLI false success falls back to exact owner termination, then verifies exit and clears receipt");
+    let next=TcpListener::bind(("127.0.0.1",port)).unwrap();
+    assert!(ScienceHostAdapter::recover_owned_runtime(port,&cache).unwrap().is_none());
+    assert!(ScienceHostAdapter::claim_stop(Some(&runtime)).is_err());
+    drop(next);
+    println!("PASS: subsequent foreign listener is preserved; port is available for a fresh start");
+}
