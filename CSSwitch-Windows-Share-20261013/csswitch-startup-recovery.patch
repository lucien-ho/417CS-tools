 fn control_url_exit_error(output: &ProcessOutput) -> AttachError {
+    // On Windows the daemon can accept connections before its local control
+    // endpoint can mint a link. Do not classify every exit=1 as readiness:
+    // only this exact, observed diagnostic is eligible for bounded retries.
+    // The coordinator revalidates the managed owner before each attempt.
+    #[cfg(windows)]
+    if output.exit_code == Some(1)
+        && output.stdout.is_empty()
+        && std::str::from_utf8(&output.stderr).is_ok_and(|text| {
+            text.trim() == "claude-science: couldn't mint a sign-in link for the running daemon — restart it with 'claude-science stop && claude-science serve'."
+        })
+    {
+        return AttachError::new(
+            "SCIENCE_CONTROL_NOT_READY",
+            "Science 已启动，本机登录链接暂未就绪；正在限时重试",
+        )
+        .retryable(true);
+    }
     // Science 0.1.60 on Windows can report this before daemon discovery is
     // ready. Require the complete known diagnostic and exit code: broad
     // substring matching would retry permission/auth/runtime failures too.
