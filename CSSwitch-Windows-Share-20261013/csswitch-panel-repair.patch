+//! Isolated native regression: no provider, Science, config or user data access.
+//! Run with WEBVIEW2_USER_DATA_FOLDER pointing at a new temporary directory.
+//! Cargo examples need the application's Windows manifest embedded before run.
+
+#[cfg(windows)]
+#[path = "../src/panel.rs"]
+mod panel;
+
+#[cfg(windows)]
+fn main() {
+    use std::sync::{atomic::{AtomicBool, AtomicUsize, Ordering}, Arc};
+    use std::time::{Duration, Instant};
+    use tauri::Manager;
+
+    assert!(std::env::var_os("WEBVIEW2_USER_DATA_FOLDER").is_some(), "isolated WebView2 folder required");
+    assert!(panel::keep_background_running(None));
+    assert!(!panel::keep_background_running(Some(0)));
+    assert!(!panel::keep_background_running(Some(1)));
+    assert!(!panel::keep_background_running(Some(tauri::RESTART_EXIT_CODE)));
+    std::thread::spawn(|| {
+        std::thread::sleep(Duration::from_secs(50));
+        eprintln!("FAIL: lifecycle test timed out");
+        std::process::exit(2);
+    });
+    let mut context = tauri::generate_context!();
+    context.config_mut().identifier = "com.csswitch.panel-lifecycle-test".into();
+    for window in &mut context.config_mut().app.windows {
+        window.url = tauri::WebviewUrl::External("about:blank".parse().unwrap());
+        window.title = "CSSwitch isolated lifecycle test".into();
+    }
+    panel::configure_context(&mut context);
+    let app = tauri::Builder::default()
+        .manage(panel::PanelState::default())
+        .build(context)
+        .expect("build isolated fixture");
+    panel::install_close_handler(app.handle());
+    let ready = Arc::new(AtomicBool::new(false));
+    let worker_ready = ready.clone();
+    let closes = Arc::new(AtomicUsize::new(0));
+    let explicit_exits = Arc::new(AtomicUsize::new(0));
+    let worker_closes = closes.clone();
+    let handle = app.handle().clone();
+    std::thread::spawn(move || {
+        let wait = |condition: &dyn Fn() -> bool| {
+            let started = Instant::now();
+            while !condition() {
+                assert!(started.elapsed() < Duration::from_secs(12), "window transition timed out");
+                std::thread::sleep(Duration::from_millis(50));
+            }
+        };
+        wait(&|| worker_ready.load(Ordering::SeqCst));
+        // Exercise an actual WebView2 creation failure, not just config validation.
+        let invalid_runtime = std::env::current_dir().unwrap().join("missing_webview_runtime");
+        std::env::set_var("WEBVIEW2_BROWSER_EXECUTABLE_FOLDER", &invalid_runtime);
+        panel::show(&handle);
+        wait(&|| !handle.webview_windows().is_empty() && panel::current_window(&handle).is_none());
+        std::env::remove_var("WEBVIEW2_BROWSER_EXECUTABLE_FOLDER");
+        println!("PASS: native creation failure returned control for a fresh retry");
+        for cycle in 1..=2 {
+            // This is the same show path called by boot and single-instance callbacks.
+            for _ in 0..4 {
+                panel::show(&handle);
+            }
+            wait(&|| panel::current_window(&handle).is_some_and(|w| w.is_visible().unwrap_or(false)));
+            std::thread::sleep(Duration::from_millis(500));
+            assert_eq!(handle.webview_windows().values().filter(|w| w.is_visible().is_ok()).count(), 1);
+            if cycle == 2 {
+                let previous = panel::current_window(&handle).unwrap().label().to_owned();
+                let overlap_app = handle.clone();
+                handle.run_on_main_thread(move || {
+                    panel::current_window(&overlap_app).unwrap().close().unwrap();
+                    panel::show(&overlap_app);
+                }).unwrap();
+                wait(&|| panel::current_window(&handle).is_some_and(|w| w.label() != previous && w.is_visible().unwrap_or(false)));
+                println!("PASS: open request during close produced a replacement panel");
+            }
+            panel::current_window(&handle).unwrap().close().unwrap();
+            wait(&|| panel::current_window(&handle).is_none() && worker_closes.load(Ordering::SeqCst) >= cycle);
+            std::thread::sleep(Duration::from_millis(700));
+            println!("PASS: cycle {cycle} opened one panel, destroyed it, and kept the host alive");
+        }
+        handle.exit(0);
+    });
+    let observed_exits = explicit_exits.clone();
+    let code = app.run_return(move |app, event| {
+        if matches!(event, tauri::RunEvent::Ready) {
+            assert!(app.webview_windows().is_empty(), "background startup created a WebView");
+            println!("PASS: completed background startup has zero WebViews");
+            ready.store(true, Ordering::SeqCst);
+        }
+        if let tauri::RunEvent::ExitRequested { api, code, .. } = event {
+            if panel::keep_background_running(code) {
+                closes.fetch_add(1, Ordering::SeqCst);
+                api.prevent_exit();
+            } else {
+                observed_exits.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+    });
+    assert_eq!(code, 0);
+    assert_eq!(explicit_exits.load(Ordering::SeqCst), 1);
+    println!("PASS: explicit exit reached the exit branch and terminated normally");
+}
+
+#[cfg(not(windows))]
+fn main() {
+    eprintln!("Windows-only native lifecycle regression");
+}
