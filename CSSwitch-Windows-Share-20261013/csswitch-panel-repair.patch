+//! Settings-window lifetime is independent of the managed background services.
+
+use tauri::Manager;
+
+#[derive(Default)]
+pub(crate) struct PanelState {
+    #[cfg(windows)]
+    inner: std::sync::Mutex<windows::PanelInner>,
+}
+
+pub(crate) fn configure_context<R: tauri::Runtime>(context: &mut tauri::Context<R>) {
+    #[cfg(windows)]
+    for window in &mut context.config_mut().app.windows {
+        if window.label == "main" {
+            window.create = false;
+        }
+    }
+    #[cfg(not(windows))]
+    let _ = context;
+}
+
+pub(crate) fn show<R: tauri::Runtime>(app: &tauri::AppHandle<R>) {
+    #[cfg(windows)]
+    {
+        let dispatcher = app.clone();
+        // Always enqueue, even when called on the main thread: close() queues
+        // its native event, while run_on_main_thread otherwise runs inline.
+        tauri::async_runtime::spawn_blocking(move || {
+            let handle = dispatcher.clone();
+            if dispatcher.run_on_main_thread(move || windows::request_open(handle)).is_err() {
+                eprintln!("CSSWITCH_PANEL_ERROR stage=dispatch");
+            }
+        });
+    }
+    #[cfg(not(windows))]
+    if let Some(window) = app.get_webview_window("main") {
+        let _ = window.show();
+        let _ = window.set_focus();
+    }
+}
+
+#[cfg(windows)]
+pub(crate) fn current_window<R: tauri::Runtime>(app: &tauri::AppHandle<R>) -> Option<tauri::WebviewWindow<R>> {
+    let label = app.state::<PanelState>().inner.lock().unwrap_or_else(|e| e.into_inner())
+        .active.as_ref().map(|active| active.label.clone())?;
+    app.get_webview_window(&label)
+}
+
+#[cfg(windows)]
+mod windows {
+    use super::*;
+
+    #[derive(Clone, Copy, PartialEq)]
+    enum Phase { Opening, Open, Closing }
+
+    pub(super) struct ActivePanel {
+        pub(super) label: String,
+        phase: Phase,
+    }
+
+    #[derive(Default)]
+    pub(super) struct PanelInner {
+        next: u64,
+        pub(super) active: Option<ActivePanel>,
+        reopen: bool,
+    }
+
+    pub(super) fn request_open<R: tauri::Runtime>(app: tauri::AppHandle<R>) {
+        let Some(mut config) = app.config().app.windows.iter().find(|w| w.label == "main").cloned() else {
+            eprintln!("CSSWITCH_PANEL_ERROR stage=missing_config");
+            return;
+        };
+        {
+            let state = app.state::<PanelState>();
+            let mut inner = state.inner.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(active) = &inner.active {
+                match active.phase {
+                    Phase::Closing => { inner.reopen = true; return; }
+                    Phase::Opening => return,
+                    Phase::Open => {
+                        drop(inner);
+                        if let Some(window) = current_window(&app) {
+                            let _ = window.show();
+                            let _ = window.set_focus();
+                        }
+                        return;
+                    }
+                }
+            }
+            inner.next += 1;
+            // Tauri can retain a registered handle after asynchronous native
+            // creation fails. Never reuse that label for a subsequent attempt.
+            config.label = format!("csswitch-settings-{}", inner.next);
+            config.visible = false;
+            inner.active = Some(ActivePanel { label: config.label.clone(), phase: Phase::Opening });
+        }
+        // WebView2 construction must not block the native event/IPC thread.
+        tauri::async_runtime::spawn_blocking(move || {
+            let result = tauri::WebviewWindowBuilder::from_config(&app, &config)
+                .and_then(|builder| builder.build())
+                // build() only queues creation. This getter confirms the native
+                // window exists after that message has been processed.
+                .and_then(|window| window.is_visible().map(|_| window));
+            if let Ok(window) = &result {
+                let event_app = app.clone();
+                let label = config.label.clone();
+                window.on_window_event(move |event| {
+                    let mut reopen = false;
+                    {
+                        let state = event_app.state::<PanelState>();
+                        let mut inner = state.inner.lock().unwrap_or_else(|e| e.into_inner());
+                        if !inner.active.as_ref().is_some_and(|p| p.label == label) { return; }
+                        match event {
+                            tauri::WindowEvent::CloseRequested { .. } => {
+                                inner.active.as_mut().unwrap().phase = Phase::Closing;
+                            }
+                            tauri::WindowEvent::Destroyed => {
+                                inner.active = None;
+                                reopen = std::mem::take(&mut inner.reopen);
+                            }
+                            _ => {}
+                        }
+                    }
+                    if reopen { show(&event_app); }
+                });
+            }
+            let finished_app = app.clone();
+            if app.run_on_main_thread(move || {
+                let state = finished_app.state::<PanelState>();
+                let mut inner = state.inner.lock().unwrap_or_else(|e| e.into_inner());
+                if !inner.active.as_ref().is_some_and(|p| p.label == config.label && p.phase == Phase::Opening) {
+                    drop(inner);
+                    if let Ok(window) = result { let _ = window.destroy(); }
+                    return;
+                }
+                match result {
+                    Ok(window) => {
+                        inner.active.as_mut().unwrap().phase = Phase::Open;
+                        drop(inner);
+                        if window.show().is_err() || window.set_focus().is_err() {
+                            eprintln!("CSSWITCH_PANEL_ERROR stage=show");
+                        }
+                    }
+                    Err(_) => {
+                        inner.active = None;
+                        eprintln!("CSSWITCH_PANEL_ERROR stage=native_create");
+                    }
+                }
+            }).is_err() {
+                eprintln!("CSSWITCH_PANEL_ERROR stage=completion_dispatch");
+            }
+        });
+    }
+}
+
+pub(crate) fn install_close_handler<R: tauri::Runtime>(app: &tauri::AppHandle<R>) {
+    // Windows uses the normal close/destroy path, releasing its WebView2.
+    #[cfg(not(windows))]
+    if let Some(window) = app.get_webview_window("main") {
+        let hidden = window.clone();
+        window.on_window_event(move |event| {
+            if let tauri::WindowEvent::CloseRequested { api, .. } = event {
+                api.prevent_close();
+                let _ = hidden.hide();
+            }
+        });
+    }
+    #[cfg(windows)]
+    let _ = app;
+}
+
+pub(crate) fn keep_background_running(exit_code: Option<i32>) -> bool {
+    // None means the last window closed. app.exit/restart supplies a code and
+    // must still reach the existing native-exit cleanup owner.
+    cfg!(windows) && exit_code.is_none()
+}
