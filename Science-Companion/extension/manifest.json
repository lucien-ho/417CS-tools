{
  "manifest_version": 3,
  "name": "Science 中文与外部打开",
  "version": "1.1.0",
  "description": "为本机 Claude Science 提供常用界面中文及 Markdown 外部应用打开。",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Science 界面助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "common.js",
        "translations.js",
        "catalog.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
